pkgname=busybox
pkgver=1.37.0
pkgrel=1.2
pkgdesc="Utilities for rescue and embedded systems"
arch=("x86_64" "aarch64")
url="https://www.busybox.net"
license=('GPL-2.0-only')
makedepends=("ncurses" "musl" "kernel-headers-musl")
validpgpkeys=('C9E9416F76E610DBD09D040F47B70C55ACC9965B')
# Holo: Disabling LTO fixes the build error `std::length_error` in CI
options=('!lto')
source=("$url/downloads/$pkgname-$pkgver.tar.bz2"{,.sig}
        "config"
        "extra_version.patch"

        # Holo: Additional patches for 1.37.0
        "sha1-hwaccel-support.patch"
        "fix-make-menuconfig.patch")
