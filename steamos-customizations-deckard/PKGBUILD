# Maintainer: Vivek Das Mohapatra <vivek.dasmohapatra@collabora.com>

pkgname=steamos-customizations-deckard
_srctag=deckard-20261002.1
_srcver=${_srctag#deckard-}
pkgver=${_srcver//-/.}
pkgrel=4
pkgdesc='SteamOS customizations (Deckard fork) - This package installs various SteamOS-specific files'
arch=('any')
url='http://repo.steampowered.com'
license=('LGPLv2+')
depends=('e2fsprogs' 'gptfdisk' 'rsync' 'util-linux' 'mkinitcpio' 'uboot-tools') # 'usb-gadget-tools')
makedepends=('git' 'openssh' 'systemd')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
source=(
	"${pkgname%-git}::git+https://github.com/evlav/deckard-steamos-customizations.git#tag=${_srctag}"

	# jupiter-hw-support commands and sundry
	"steamos-select-branch"
	"steamos-update"
	"steamos-prepare-oobe-test"
	"jupiter-biosupdate"
	"org.valve.steamos.prepare-oobe-test.policy"

	# muscle-memory old commands
	"dupdate"
	"atomupd-client.conf"
	"makerootfsrw"

	# image signing keys.
	"frame-main.cert.pem"
	"steamos-stable.cert.pem"

	# This exists in jupiter-legacy-support, so we include it here for Deckard.
	# We need this otherwise flatpak doesn't setup its directory structure properly.
	"flatpak-modify-flathub-beta.service"

	# This is deckard-specific; we run with special CPUAffinity settings to keep
	# most services off of the power-hungry cores, but we want SSH sessions to
	# have the full power of the unit.
	"override-sshd-cpu-affinity.conf"

	# USB gadget customization
	"override-usb-gadget.conf"
	"override-adbd.conf"
	"typec-plug-event.rules"
	"typec-plug-event.sh"
	"usb-ncm-dnsmasq.sh"
	"usb-ncm-dnsmasq@.service"
	"usb-ncm-gadget.sh"
	"usb-ncm-gadget@.service"

	# We customize rtkit's behavior
	"override-rtkit-limits.conf"

	# CPU scheduler setting
	"steamos-scheduler.service"
	"steamos-scheduler.default"

	# We have a couple of bash shortcuts that we like to use
	"vrshortcuts.sh"
	"serial_resize.sh"

	# Work around podman behavior for lepton
	"lepton-podman-timeout.conf"

	# Allow proxy variables through `sudo`
	"sudo_proxy_vars"

	# steamos-bootconf set-mode service
	'steamos-boot.service'

	# fex bash helper script
	'FEXBash'

	# initrd generation, wrapped for U-Boot
	'deckard-uimage'
)
