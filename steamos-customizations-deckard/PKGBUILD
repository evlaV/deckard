package() {
	# Install specific pieces of configuration that we want
	INSTALL_TARGETS=(
		install-atomic-update
		install-debuginfod
		install-desync
		install-misc
		install-NetworkManager
		install-offload
		install-swap 
	)
	cd "${pkgname%-git}"
	make DESTDIR="$pkgdir" prefix="/usr" sbindir="/usr/bin" libexecdir="/usr/lib" \
		 ATOMUPD_META_URL=https://steamdeck-atomupd.steamos.cloud/meta \
		 ATOMUPD_IMAGES_URL=https://steamdeck-images.steamos.cloud/ \
		 ATOMUPD_VARIANTS_LIST='vr' \
		 ATOMUPD_BRANCHES_LIST='stable;rc;beta;bc;preview;pc;main' \
		 "${INSTALL_TARGETS[@]}"

	# We have authentication credentials saved in this file while our repositories are still secret
	# We can drop this once we're no longer hiding behind an authenticated endpoint
	install -TDm644 "${srcdir}/atomupd-client.conf" "${pkgdir}/etc/steamos-atomupd/client.conf"

	# We don't install the jupiter-hw-support package, so we have dummy scripts here
	install -TDm755 "${srcdir}/jupiter-biosupdate" "${pkgdir}/usr/bin/jupiter-biosupdate"
	install -TDm755 "${srcdir}/jupiter-biosupdate" "${pkgdir}/usr/bin/steamos-polkit-helpers/jupiter-biosupdate"
	install -TDm755 "${srcdir}/steamos-select-branch" "${pkgdir}/usr/bin/steamos-select-branch"
	install -TDm755 "${srcdir}/steamos-update" "${pkgdir}/usr/bin/steamos-update"
	install -TDm755 "${srcdir}/steamos-prepare-oobe-test" "${pkgdir}/usr/bin/steamos-prepare-oobe-test"
	install -TDm644 "${srcdir}/org.valve.steamos.prepare-oobe-test.policy" "${pkgdir}/usr/share/polkit-1/actions/org.valve.steamos.prepare-oobe-test.policy"


	# We include this file because lots of people have muscle-memory to use `dupdate` instead of `atomupd-manager`
	install -TDm755 "${srcdir}/dupdate" "${pkgdir}/usr/bin/dupdate"
	install -TDm755 "${srcdir}/makerootfsrw" "${pkgdir}/usr/bin/makerootfsrw"

	install -TDm644 "${srcdir}/frame-main.cert.pem" "${pkgdir}/etc/rauc/development_keys/2549da1b.0"
	install -TDm644 "${srcdir}/steamos-stable.cert.pem" "${pkgdir}/etc/rauc/trusted_keys/ba942c60.0"

	install -TDm644 "${srcdir}/flatpak-modify-flathub-beta.service" "${pkgdir}/usr/lib/systemd/system/flatpak-modify-flathub-beta.service"

	# System service customizations
	install -TDm644 "${srcdir}/typec-plug-event.rules" "${pkgdir}/usr/lib/udev/rules.d/typec-plug-event.rules"
	install -TDm755 "${srcdir}/typec-plug-event.sh" "${pkgdir}/usr/share/deckard/typec-plug-event.sh"
	install -TDm644 "${srcdir}/override-usb-gadget.conf" "${pkgdir}/usr/lib/systemd/system/usb-gadget-init.service.d/usb-gadget.conf"
	install -TDm644 "${srcdir}/override-adbd.conf" "${pkgdir}/usr/lib/systemd/system/adbd-init.service.d/adbd.conf"
	install -TDm644 "${srcdir}/override-adbd.conf" "${pkgdir}/usr/lib/systemd/system/adbd.service.d/adbd.conf"
	install -TDm644 "${srcdir}/override-sshd-cpu-affinity.conf" "${pkgdir}/usr/lib/systemd/system/sshd.service.d/sshd-cpu-affinity.conf"
	install -TDm644 "${srcdir}/override-rtkit-limits.conf" "${pkgdir}/usr/lib/systemd/system/rtkit-daemon.service.d/rtkit-limits.conf"
	install -TDm755 "${srcdir}/usb-ncm-dnsmasq.sh" "${pkgdir}/usr/share/deckard/usb-ncm-dnsmasq.sh"
	install -TDm644 "${srcdir}/usb-ncm-dnsmasq@.service" "${pkgdir}/usr/lib/systemd/system/usb-ncm-dnsmasq@.service"
	install -TDm755 "${srcdir}/usb-ncm-gadget.sh" "${pkgdir}/usr/share/deckard/usb-ncm-gadget.sh"
	install -TDm644 "${srcdir}/usb-ncm-gadget@.service" "${pkgdir}/usr/lib/systemd/system/usb-ncm-gadget@.service"

	# Helpful bash shortcuts
	install -Dm755 "${srcdir}/vrshortcuts.sh" "${pkgdir}/etc/bashrc.d/vrshortcuts.sh"
	install -Dm755 "${srcdir}/serial_resize.sh" "${pkgdir}/etc/profile.d/serial_resize.sh"

	# CPU scheduler setting
	install -Dm644 "${srcdir}/steamos-scheduler.service" "${pkgdir}/usr/lib/systemd/user/steamos-scheduler.service"
	install -Dm644 "${srcdir}/steamos-scheduler.default" "${pkgdir}/etc/default/steamos-scheduler"
	mkdir -p "${pkgdir}/usr/lib/systemd/user/graphical-session.target.wants"
	ln -Ts ../steamos-scheduler.service "${pkgdir}/usr/lib/systemd/user/graphical-session.target.wants/steamos-scheduler.service"

	# Mark good service
	install -Dm644 "${srcdir}/steamos-boot.service" "${pkgdir}/usr/lib/systemd/system/steamos-boot.service"

	# Install podman dropin for lepton
	install -TDm644 "${srcdir}/lepton-podman-timeout.conf" "${pkgdir}/usr/lib/systemd/user/podman.service.d/lepton-podman-timeout.conf"

	# Allow HTTP proxy variables through the `sudo` boundary
	install -Dm600 "${srcdir}/sudo_proxy_vars" "${pkgdir}/etc/sudoers.d/proxy_vars"

	# FEXBash helper script to try to run FEXBash within steam dir if SLR4 and FEX-Emu compat tools exist
	install -TDm755 "${srcdir}/FEXBash" "${pkgdir}/usr/bin/FEXBash"

	# Wrap the initramfs built from our kernels' mkinitcpio presets for U-Boot
	install -TDm755 "${srcdir}/deckard-uimage" "${pkgdir}/usr/lib/initcpio/post/deckard-uimage"

	# TODO: Make hibernation work
	rm -rf "${pkgdir}/usr/lib/systemd/sleep.conf.d"
}
