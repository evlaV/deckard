build() {
  # Deckard:
  #  - Allow wrap-based downloading of dependencies, because things like
  #    perfetto are rather difficult to build for mesa, and we need them.
  #    We will pass fixing these build recipes off to Collabora.
  #  - Only build zink and freedreno
  #  - Enable lots of tools like perfetto, valgrind
  #  - Build once for x86_64, once for i386
  MESON_OPTIONS=(
    --prefix=/usr
    --wrap-mode=default
    -D android-libbacktrace=disabled
    -D android-libperfetto=disabled
    -D gallium-drivers=zink
    -D gallium-va=disabled
    -D gallium-mediafoundation=disabled
    -D gbm=enabled
    -D glvnd=enabled
    -D glx-direct=true
    -D glx=auto
    -D gpuvis=true
    -D intel-rt=disabled
    -D llvm=disabled
    -D libunwind=disabled
    -D microsoft-clc=disabled
    -D perfetto=true
    -D platforms=x11,wayland
    -D tools=freedreno,drm-shim
    -D valgrind=enabled
    -D vulkan-drivers=freedreno
    -D vulkan-layers=vram-report-limit
    -D tu-build-id="${_tu_build_id}"
  )
  arch-meson mesa build64 \
    --buildtype=release \
    -D b_ndebug=true \
    --cross-file "${srcdir}/linux-x86_64.cross" \
    "${MESON_OPTIONS[@]}"
  ninja -C build64

  arch-meson mesa build32 \
    --buildtype=release \
    -D b_ndebug=true \
    --cross-file "${srcdir}/linux-i386.cross" \
    "${MESON_OPTIONS[@]}"
  ninja -C build32

  # Assert builds
  arch-meson mesa build64_assert \
    --buildtype=debugoptimized \
    -D b_ndebug=false \
    --cross-file "${srcdir}/linux-x86_64.cross" \
    "${MESON_OPTIONS[@]}"
  ninja -C build64

  arch-meson mesa build32_assert \
    --buildtype=debugoptimized \
    -D b_ndebug=false \
    --cross-file "${srcdir}/linux-i386.cross" \
    "${MESON_OPTIONS[@]}"
  ninja -C build32
}

package_deckard-mesa-linux-x86_64() {
  conflicts+=( 'deckard-mesa-linux-x86_64-assert' )
  options+=( 'debug' 'strip' )
  DESTDIR="${pkgdir}/usr/share/guestos/fex-mesa" meson install -C build64
  DESTDIR="${pkgdir}/usr/share/guestos/fex-mesa" meson install -C build32

  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgbase}" LICENSE
  install -m644 -Dt "${pkgdir}/usr/share/guestos/fex-mesa" graphics_provider.json
}

package_deckard-mesa-linux-x86_64-assert() {
  conflicts+=( 'deckard-mesa-linux-x86_64' )
  options+=( '!debug' '!strip' )
  DESTDIR="${pkgdir}/usr/share/guestos/fex-mesa" meson install -C build64_assert
  DESTDIR="${pkgdir}/usr/share/guestos/fex-mesa" meson install -C build32_assert

  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgbase}" LICENSE
  install -m644 -Dt "${pkgdir}/usr/share/guestos/fex-mesa" graphics_provider.json
}
