             # 32-bit runtime dependencies
             'lib32-libdrm' 'lib32-wayland' 'lib32-libxshmfence' 'lib32-libelf' 'lib32-zstd' 'lib32-vulkan-icd-loader' 'lib32-libxfixes' 'lib32-libglvnd' 'lib32-libxrandr' 'lib32-readline' 'lib32-libarchive' 'lib32-systemd'
             'lib32-libdisplay-info'
             )
