@@ -3636,12 +3636,10 @@
   if (solib == nullptr)
     return 0;
 
-  /* This is always called for solibs with an associated objfile.  */
-  gdb_assert (solib->objfile != nullptr);
-
-  svr4_info *info = get_svr4_info (solib->objfile->pspace ());
