pkgname=deckard-uboot
source ../deckard-uboot/uboot_common.pkgbuild
pkgver="${_uboot_srctag}"
pkgrel="${_pkgrel:-1}"
arch=('aarch64')
license=('GPL-2.0+' 'BSD' 'OFL-1.1')
pkgdesc="Deckard second-stage bootloader and firmware"
url='https://github.com/evlav/deckard-u-boot'
depends=('coreutils')
makedepends=(
    'git' 'openssl' 'xz' 'zstd' 'clang' 'lld' 'uboot-tools' 'python3'
)
options=('!strip' '!debug' '!lto')
source=(
    "git+https://github.com/evlav/deckard-u-boot.git#tag=${_uboot_srctag}"
)
sha512sums=('da016ae2026902d748b9536e7b7dd9e3eeca032fac4cd4e178ff3267a08538336508a4ac312e13ec6cb1737a5382caf7dfa3113f17758a0012f43f392b8087c5')

# Helper function to read a config variable from the u-boot configuration
_UBOOT_CONFIG_NAME=sm8650-deckard_defconfig
_read_config_var() {
    grep "CONFIG_$1" "${srcdir}/u-boot/configs/${_UBOOT_CONFIG_NAME}" | cut -d= -f2-
}

build() {
    mkdir -p "${srcdir}/build"

    # We want reproducible builds, because we're going to use the hash of the output files to trigger bootloader updates
    export SOURCE_DATE_EPOCH=$(git -C u-boot log -1 --format=%ct)
    MAKE_FLAGS=(
        # Out of tree build
        O="${srcdir}/build"
        ARCH=arm
    )

    # Create uboot.env file and tell u-boot it's the default environment file
    echo "bootdelay=2" >> ${srcdir}/build/uboot-env.txt
    echo "verify=n" >> ${srcdir}/build/uboot-env.txt
    echo "default_bootargs=loglevel=3 rd.log=console rd.log=file" >> ${srcdir}/build/uboot-env.txt
    MAKE_FLAGS+=(
        CONFIG_USE_DEFAULT_ENV_FILE=y
        CONFIG_DEFAULT_ENV_FILE="uboot-env.txt"
    )

    # Load config
    make -C u-boot "${MAKE_FLAGS[@]}" "${_UBOOT_CONFIG_NAME}"

    # Build
    make -C u-boot "${MAKE_FLAGS[@]}"

    # Get release string
    make -s -C u-boot "${MAKE_FLAGS[@]}" ubootrelease > build/ubootrelease.txt
}

package()
{
    # Our u-boot build must further be wrapped and deployed to lun images, we output the intermediate products to `/usr/lib/u-boot`.
    # A typical user device will not actually install the `deckard-uboot` package, but instead `deckard-boot-firmware`.
    install -TDm644 u-boot/configs/${_UBOOT_CONFIG_NAME} ${pkgdir}/usr/lib/u-boot/u-boot.cfg
    install -TDm644 build/u-boot-elf.lds ${pkgdir}/usr/lib/u-boot/spl.lds
    install -TDm755 build/u-boot.img ${pkgdir}/usr/lib/u-boot/u-boot.img
    install -TDm755 build/spl/u-boot-spl.bin ${pkgdir}/usr/lib/u-boot/spl.bin
    install -TDm644 build/spl/u-boot-spl.dtb ${pkgdir}/usr/lib/u-boot/spl.dtb
    install -TDm644 build/uboot-env.txt ${pkgdir}/usr/lib/u-boot/uboot-env.txt
    install -TDm644 build/ubootrelease.txt ${pkgdir}/usr/lib/u-boot/ubootrelease.txt
    install -TDm644 "${srcdir}/u-boot/Licenses/OFL.txt" "${pkgdir}/usr/share/licenses/u-boot/OFL.txt"
}
