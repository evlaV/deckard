From 31b75839368565a0f8bf8fb6918847a37aad6db5 Mon Sep 17 00:00:00 2001
From: Matthieu Bucchianeri <mbucchia@valvesoftware.com>
Date: Wed, 7 Oct 2026 16:37:24 -0700
Subject: [PATCH] Do not install OpenXR SDK.

---
 CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 02e84e053..f69a82760 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -436,7 +436,7 @@ if (OPENXR_SUPPORT_ENABLED)
     # that cannot be exported, causing CMake errors during install(EXPORT ...) operations.
     option(BUILD_WITH_SYSTEM_JSONCPP "" OFF)
 
-    add_subdirectory(${PROJECT_SOURCE_DIR}/external/OpenXR-SDK)
+    add_subdirectory(${PROJECT_SOURCE_DIR}/external/OpenXR-SDK EXCLUDE_FROM_ALL)
     target_include_directories(OpenXR INTERFACE ${PROJECT_SOURCE_DIR}/external/OpenXR-SDK/include)
     target_compile_definitions(OpenXR INTERFACE XR_NO_PROTOTYPES ENABLE_OPENXR_SUPPORT=1)
 endif()
