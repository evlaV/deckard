pkgname=gpuvis
_commit=504eb62fe52b5e3c1a17e6ca049b5e39b20fffc3
pkgver=0.1+git${_commit:0:8}
pkgrel=1.3
pkgdesc="A Linux GPU profiler"
arch=('aarch64')
url="https://github.com/mikesart/gpuvis"
license=('MIT')
depends=(gtk3 sdl2 rapidjson)
makedepends=('ninja' 'cmake' 'cmake>=3.16.0')
source=("git+https://github.com/mikesart/gpuvis.git#commit=${_commit}")
sha256sums=('SKIP')

prepare(){
    cd ${pkgname}
    sed -i CMakeLists.txt \
      -e 's/cmake_minimum_required( VERSION 2.8 FATAL_ERROR )/cmake_minimum_required( VERSION 3.5 FATAL_ERROR )/'
    sed -i cmake/ucm.cmake \
      -e 's/cmake_minimum_required(VERSION 2.8.12)/cmake_minimum_required(VERSION 3.5)/'
}

build() {
    cmake -G Ninja \
          -S gpuvis \
          -B build \
          -D CMAKE_BUILD_TYPE=Release \
          -D CMAKE_INSTALL_PREFIX=/usr

    ninja -C build
}

package() {
    # gpuvis doesn't have an install step?
    #DESTDIR="$pkgdir" cmake --install build
    install -Dm755 "${srcdir}/build/gpuvis" "${pkgdir}/usr/bin/gpuvis"
    install -Dm644 "${srcdir}/gpuvis/LICENSE" "${pkgdir}/usr/share/licenses/gpuvis/LICENSE"
}
