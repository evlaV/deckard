# Maintainer David Edmundson (bluesystems@davidedmundson.co.uk)

pkgname=steamdeck-kde-presets
_srctag=3.8.3
_commit=a25a0592ffe4a5f358371b51eb2b5a7525f58058
pkgver=${_srctag#jupiter-}
pkgrel=14
arch=('any')
url=""
pkgdesc="Steamdeck KDE Presets"
license=('GPL2')
depends=('kdialog')
makedepends=('git' 'openssh')
source=(
    "git+https://github.com/evlav/deckard-steamdeck-kde-presets.git#commit=$_commit"
    "powerdevilrc"
    "deckard-nested-desktop.desktop"
)
sha512sums=('SKIP'
            'dd0471eb6a0e566c870d25ca76ba858e608ffdb624ddb722cde4adda8a77e3a22e6e5820d657e24752deff035ad9f5b582a239622488fbe148a551549861f7c8'
            '9cc7b838970bf945b509f8bc1e3b63b3dc2346dc1a6f495ffa3727307648e769a079eed6bb5b24b480af3a875df166f8c905efc66595c1677d63d0a26b9fa1f2')

package() {
    cp -R "$srcdir"/steamdeck-kde-presets/* "$pkgdir"
    install -d -m0755 "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"
    ln -s ../steamos-set-plasma-theme.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/"

    if [[ "${CARCH}" == "aarch64" ]]; then
        install -Dm655 powerdevilrc "${pkgdir}/etc/xdg/powerdevilrc"

        # misyl: Add a version to the normal applications list
        # So it shows up in the non-Steam app launcher on Steam Frame.
        install -Dm655 deckard-nested-desktop.desktop "${pkgdir}/usr/share/applications/deckard-nested-desktop.desktop"

        # Remove the other shortcut that exists.
        rm "${pkgdir}/usr/share/applications/steam/steamos-nested-desktop/steamos-nested-desktop.desktop"
    fi
}
