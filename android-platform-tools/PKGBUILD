prepare() {
  local patch=
  cd "$pkgname"

  ln -sfT "$srcdir/squashfs-tools" external/squashfs-tools

  for patch in "${source[@]}"
  do
    case $patch in
      *.patch) patch -p1 < ../"$patch" ;;
    esac
  done
}

build() {
  local -r VPATH=${srcdir}/${pkgname}

  mkdir -p ${srcdir}/build
  cd ${srcdir}/build

  # run V=1 makepkg … to get show the full commands run.
  #
  # TRACE_BUILDSYSTEM=1 will show you which objects are
  # added by each makefile
  #
  # To disable a component, remove its include line from
  # package.mk
  make VERSION=${pkgver} CARCH=${CARCH} VPATH=${VPATH} \
       -f ../package.mk debug-build all
}

check() {
  local -r VPATH=${srcdir}/${pkgname}

  cd ${srcdir}/build
  make PKGNAME=${pkgname} VERSION=${pkgver} CARCH=${CARCH} VPATH=${VPATH} \
       -f ../package.mk check
}

package() {
  local -r VPATH=${srcdir}/${pkgname}

  cd ${srcdir}/build
  make PKGNAME=${pkgname} VERSION=${pkgver} CARCH=${CARCH} VPATH=${VPATH} \
       DESTDIR=${pkgdir} \
       -f ../package.mk install

  install -D -t $pkgdir/usr/share/doc/${pkgname} ../copyright
}
