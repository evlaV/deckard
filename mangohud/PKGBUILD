# Get `download_git` available for use
source /usr/share/makepkg/util/source.sh
source /usr/share/makepkg/source/git.sh
pkgver() {
  # This to allow `pkgver()` to work from `find_unbuilt_packages.sh`
  if [[ ! -d mangohud ]]; then
    if [[ ! -v "startdir" ]]; then
      startdir="$(pwd)"
    fi
    download_git "${source[0]}" >/dev/null
  fi
  cd mangohud
  git describe --tags | sed -r 's/^v//;s/([^-]*-g)/r\1/;s/-/./g'
}

prepare() {
  cd mangohud

  # meson subprojects
  ln -sfv "$srcdir/imgui-1.89.9" subprojects
  ln -sfv "$srcdir/implot-0.16" subprojects
  ln -sfv "$srcdir/Vulkan-Headers-1.2.158" subprojects
}

build() {
  local meson_options=(
    -D append_libdir_mangohud=false
    -D use_system_spdlog=enabled
    -D mangoapp=true
    -D mangohudctl=true
    -D with_xnvctrl=disabled
    -D with_nvml=disabled
    -D tests=disabled
    -D with_fex=true
  )

  arch-meson mangohud build64 "${meson_options[@]}"
  meson compile -C build64
}

package_mangohud() {
  conflicts=('mangohud-common')
  meson install -C build64 --destdir "$pkgdir"
  install -m644 -Dt "$pkgdir/usr/share/licenses/$pkgname" mangohud/LICENSE
}

