From 09cedbb3565d68a3bc1ea0f5b10f881258beeceb Mon Sep 17 00:00:00 2001
From: Drew Gottlieb <drewg@valvesoftware.com>
Date: Mon, 16 Nov 2026 15:21:26 -0800
Subject: [PATCH] battery: show Steam Frame's external battery pack

With the Boulder head strap, Steam Frame can also run on an external
battery pack. deckard-charger writes the pack's level and status to
/run/deckardcharger, but battery_percent and battery_status only cover
the internal battery.

While a pack is attached, show a BATT (EXT) row (EXT inline) under
BATT with its level, plus the plug icon while USB is charging it, or
its remaining time while it's discharging.

The remaining time summed both batteries' charge over their average
current, counting the internal battery's charging current as drain. On
Steam Frame, show each battery's time from deckard-charger instead, as
Steam does. The internal battery has none while the pack runs the
headset.
---
 src/battery.cpp      |  23 ++++++++
 src/battery.h        |   6 +++
 src/hud_elements.cpp | 126 ++++++++++++++++++++++++++-----------------
 3 files changed, 107 insertions(+), 48 deletions(-)

diff --git a/src/battery.cpp b/src/battery.cpp
index b6b910a..aa2d9ba 100644
--- a/src/battery.cpp
+++ b/src/battery.cpp
@@ -57,9 +57,27 @@ void BatteryStats::update() {
         current_watt = getPower();
         current_percent = getPercent();
         remaining_time = getTimeRemaining();
+        updateExternal();
     }
 }
 
+// deckard-charger only writes these with the Boulder head strap
+void BatteryStats::updateExternal() {
+    external_present = read_line("/run/deckardcharger/external_battery_present") == "1";
+    if (!external_present)
+        return;
+
+    float percent = 0.0f;
+    if (try_stof(percent, read_line("/run/deckardcharger/external_battery_percent")))
+        external_percent = percent;
+    external_status = read_line("/run/deckardcharger/external_battery_status");
+
+    float secs = 0.0f;
+    external_remaining_time = -1.0f;
+    if (try_stof(secs, read_line("/run/deckardcharger/external_secs_until_shutdown_request")) && secs > 0)
+        external_remaining_time = secs / 3600.0f;
+}
+
 float BatteryStats::getPercent()
 {
     float charge_n = 0;
@@ -207,6 +225,11 @@ float BatteryStats::getPower() {
 }
 
 float BatteryStats::getTimeRemaining() {
+    // On Steam Frame, show the same time Steam does. It's -1 while the internal battery isn't powering the headset (e.g. the external pack is).
+    float deckard_secs = 0.0f;
+    if (try_stof(deckard_secs, read_line("/run/deckardcharger/secs_until_shutdown_request")))
+        return deckard_secs < 0 ? -1.0f : deckard_secs / 3600.0f;
+
     float current = 0.0f;
     float charge = 0.0f;
 
diff --git a/src/battery.h b/src/battery.h
index 47312bd..eb92665 100644
--- a/src/battery.h
+++ b/src/battery.h
@@ -7,6 +7,7 @@ class BatteryStats{
     public:
         void numBattery();
         void update();
+        void updateExternal();
         float getPower();
         float getPercent();
         float getTimeRemaining();
@@ -19,6 +20,11 @@ class BatteryStats{
         int batt_count=0;
         bool batt_check = false;
         std::vector<float> current_now_vec = {};
+        // Steam Frame's external battery pack
+        bool external_present = false;
+        float external_percent = 0;
+        float external_remaining_time = -1;
+        std::string external_status;
 };
 
 extern BatteryStats Battery_Stats;
