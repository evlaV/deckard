pkgname=deckard-steamvr-session
pkgver=1.7.0
pkgrel=4
pkgdesc="SteamVR session manager for deckard"
arch=('aarch64')
url="https://store.steampowered.com/app/250820/SteamVR/"
license=('MIT')
depends=(
    'deckard-steamvr'
    'deckard-steam'
    'gamescope'
    'sddm'
)
makedepends=()
optdepends=(
    'xdg-desktop-portal-kde: FileChooser portal in gamescope-session'
)
backup=()
source=(
    # Gamescope session
    'gamescope-session'
    'gamescope-session.service'
    'gamescope-session.target'
    'gamescope-cleanup'
    'gamescope-env-list'
    'gamescope-onready'
    'ibus-gamescope.service'
    'start-gamescope-session'
    'gamescope-wayland.desktop'

    # Plasma session
    'plasma-session.target'
    'plasma.desktop'
    'steamvr-plasma.service'

    # SDDM
    'steamos-session-select'
    'sddm-steamos.conf'

    # Configs
    'mesavars.sh'
    'gamescope-portals.conf'
    'kde.portal'
)
