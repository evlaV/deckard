package() {
    install -TDm755 mesavars.sh "${pkgdir}/usr/share/deckard/mesavars.sh"

    STEAMOS_SCRIPTS=(
        gamescope-session
        gamescope-env-list
        gamescope-cleanup
        gamescope-onready
    )
    for SCRIPT in "${STEAMOS_SCRIPTS[@]}"; do
        install -TDm755 "${SCRIPT}" "${pkgdir}/usr/lib/steamos/${SCRIPT}"
    done

    # Install user systemd scripts
    USER_SERVICES=(
        plasma-session.target
        gamescope-session.service
        gamescope-session.target
        steamvr-plasma.service
        ibus-gamescope.service
    )
    for USER_SERVICE in "${USER_SERVICES[@]}"; do
        install -TDm644 "${USER_SERVICE}" "${pkgdir}/usr/lib/systemd/user/${USER_SERVICE}"
    done

    # Install session .desktop files
    SESSIONS=(
        gamescope-wayland
        plasma
    )
    for SESSION in "${SESSIONS[@]}"; do
        install -TDm644 "${SESSION}.desktop" "${pkgdir}/usr/share/wayland-sessions/${SESSION}.desktop"
    done

    # Executable helpers
    install -TDm755 steamos-session-select "${pkgdir}/usr/bin/steamos-session-select"
    install -TDm755 start-gamescope-session "${pkgdir}/usr/bin/start-gamescope-session"
    install -TDm644 sddm-steamos.conf "${pkgdir}/etc/sddm.conf.d/steamos.conf"

    # portals
    install -TDm644 gamescope-portals.conf "${pkgdir}/usr/share/xdg-desktop-portal/gamescope-portals/gamescope-portals.conf"
    install -TDm644 kde.portal "${pkgdir}/usr/share/xdg-desktop-portal/gamescope-portals/kde.portal"
}
