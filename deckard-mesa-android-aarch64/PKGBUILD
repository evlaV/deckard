build() {
  # Build android libdrm first.  This will be provided by the AOSP rootfs,
  # but mesa needs to link against it.  We just build it here as it's
  # pretty quick to build and is easy enough to vendor in, although we do
  # not redistribute it, we rely upon it existing within the AOSP rootfs.
  cd ${srcdir}/libdrm
  meson setup build \
    --prefix "${srcdir}/libdrm/build/prefix" \
    --cross-file "${srcdir}/android-aarch64.cross" \
    -D intel=disabled \
    -D radeon=disabled \
    -D amdgpu=disabled \
    -D nouveau=disabled \
    -D vmwgfx=disabled \
    -D freedreno=enabled \
    -D etnaviv=disabled \
    -D vc4=disabled
  ninja -C build
  meson install -C build

  MESON_OPTIONS=(
    --cross-file "${srcdir}/android-aarch64.cross"
    -D allow-kcmp=enabled
    -D android-libbacktrace=disabled
    -D android-stub=true
    -D android-strict=false
    -D cpp_rtti=false
    -D egl=enabled
    -D gallium-drivers=zink
    -D gbm=enabled
    -D gpuvis=true
    -D llvm=disabled
    -D lmsensors=disabled
    -D perfetto=true
    -D platform-sdk-version=30
    -D platforms=android
    -D shader-cache=enabled
    -D vulkan-drivers=freedreno
    -D tu-build-id="${_tu_build_id}"
    -D pkg_config_path=${srcdir}/libdrm/build/prefix/lib/pkgconfig
  )

  cd ${srcdir}/mesa
  meson setup build \
    "${MESON_OPTIONS[@]}" \
    --prefix "${srcdir}/build" \
    --buildtype=release \
    -D b_ndebug=true
  ninja -C build
  meson install -C build

  meson setup build_assert \
    "${MESON_OPTIONS[@]}" \
    --prefix "${srcdir}/build_assert" \
    --buildtype=debugoptimized \
    -D b_ndebug=false
  ninja -C build_assert
  meson install -C build_assert
}

function _do_package()
{
  # We extract only very specific files, and re-name them for Android's benefit
  # We do this very explicitly so that we notice if one of these files is missing.
  android_prefix="${pkgdir}/usr/share/guestos/android"
  for lib in EGL GLESv1_CM GLESv2; do
    install -m755 -D "${1}/lib/lib${lib}.so" "${android_prefix}/vendor/lib64/egl/lib${lib}_mesa.so"
  done
  for lib in gbm_mesa gallium_dri; do
    install -m755 -D "${1}/lib/lib${lib}.so" "${android_prefix}/vendor/lib64/lib${lib}.so"
  done
  install -m755 -D "${1}/lib/libvulkan_freedreno.so" "${android_prefix}/vendor/lib64/hw/vulkan.freedreno.so"
  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgbase}" LICENSE
}

package_deckard-mesa-android-aarch64() {
  conflicts+=( 'deckard-mesa-android-aarch64-assert' )
  options+=( 'debug' 'strip' )
  _do_package "${srcdir}/build"
}

package_deckard-mesa-android-aarch64-assert() {
  conflicts+=( 'deckard-mesa-android-aarch64' )
  options+=( '!debug' '!strip' )
  _do_package "${srcdir}/build_assert"
}
