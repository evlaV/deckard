# toolchain build order: linux-api-headers->glibc->binutils->gcc->glibc->binutils->gcc

# This so that our kernel/module builds always happen in lockstep
source ../linux-618-deckard/kernel_common.pkgbuild

pkgname=linux-api-headers
pkgver="${_pkgver:-6.18.0}"
pkgrel="${_pkgrel:-1}"
pkgdesc='Kernel headers sanitized for use in userspace'
arch=(x86_64 aarch64)
url='https://www.gnu.org/software/libc'
license=(GPL-2.0)
makedepends=(rsync)
source=(
  linux-${pkgver}::git+https://github.com/evlav/deckard-linux.git#commit=$_commit
)
sha256sums=('SKIP')

build() {
  cd linux-$pkgver

  make mrproper
}

package() {
  cd linux-$pkgver
  make INSTALL_HDR_PATH="$pkgdir/usr" headers_install

  # use headers from libdrm
  rm -r "$pkgdir/usr/include/drm"
}
