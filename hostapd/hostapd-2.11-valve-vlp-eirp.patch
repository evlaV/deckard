diff --git a/src/ap/ap_config.h b/src/ap/ap_config.h
index ced2181ab..333f1fc3f 100644
--- a/src/ap/ap_config.h
+++ b/src/ap/ap_config.h
@@ -1269,6 +1269,23 @@ hostapd_set_oper_chwidth(struct hostapd_config *conf,
 	conf->vht_oper_chwidth = oper_chwidth;
 }
 
+static inline u8 hostapd_get_tpe_count(struct hostapd_config *conf)
+{
+	switch (hostapd_get_oper_chwidth(conf)) {
+	case CONF_OPER_CHWIDTH_USE_HT:
+		return conf->secondary_channel == 0 ? 0 : 1;
+	case CONF_OPER_CHWIDTH_80MHZ:
+		return 2;
+	case CONF_OPER_CHWIDTH_80P80MHZ:
+	case CONF_OPER_CHWIDTH_160MHZ:
+	case CONF_OPER_CHWIDTH_320MHZ:
+		/* 320 MHz currently reuses the highest HE TPE entry. */
+		return 3;
+	default:
+		return 0;
+	}
+}
